# --- LLM ---------------------------------------------------------------
OPENAI_API_KEY=sk-...
# Optional: any OpenAI-compatible endpoint (OpenRouter, vLLM, Ollama, ...)
# OPENAI_BASE_URL=https://openrouter.ai/api/v1

LTM_CHAT_MODEL=gpt-4o-mini
# Model that rewrites the user profile (defaults to LTM_CHAT_MODEL, temperature 0)
# LTM_MEMORY_MODEL=gpt-4o-mini
LTM_CHAT_TEMPERATURE=0.7

# --- Persistence -------------------------------------------------------
# memory -> InMemoryStore + MemorySaver (same as the notebook, lost on restart)
# sqlite -> SqliteStore + SqliteSaver   (survives restarts)
LTM_BACKEND=sqlite
# LTM_DATA_DIR=./data

# --- Optional: LangSmith tracing ---------------------------------------
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=ltm-chat
